meta {
  name: 首次日志应为no_logs
  type: http
  seq: 3
}

get {
  url: {{ip}}/api/domain/{{check_domain}}/logs?user={{check_user}}&pwd={{check_pwd}}
  body: none
  auth: inherit
}

params:query {
  user: {{check_user}}
  pwd: {{check_pwd}}
}

settings {
  encodeUrl: true
  timeout: 15000
}

tests {
  test('新域没有日志', () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal('no_logs');
    expect(res.getHeader('content-type')).to.include('application/json');
  });
}

docs {
  先创建新测试域；无日志返回 JSON no_logs，而不是文本 completed。
}

