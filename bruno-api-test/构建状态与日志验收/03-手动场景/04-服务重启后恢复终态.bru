meta {
  name: 服务重启后恢复终态
  type: http
  seq: 4
}

get {
  url: {{ip}}/api/domain/{{check_domain}}/status?user={{check_user}}&pwd={{check_pwd}}
  body: none
  auth: inherit
}

params:query {
  user: {{check_user}}
  pwd: {{check_pwd}}
}

settings {
  encodeUrl: true
  timeout: 15000
}

script:pre-request {
  if ((bru.getVar('check_manual_case') ?? bru.getFolderVar('check_manual_case')) !== 'restart') {
    if (req.getExecutionMode() === 'runner') { bru.runner.skipRequest(); }
    else { throw new Error('请先按 Docs 准备场景，并将父文件夹 check_manual_case 设为 restart'); }
  }
}

tests {
  test('清空服务内存后从同一日志恢复结果', () => {
    expect(res.getStatus()).to.equal(200);
    const b=res.getBody();expect(b.taskId).to.equal(bru.getVar('check_task_id'));
    const previous=bru.getVar('check_finished_status');
    expect(['succeeded','failed']).to.include(previous);
    expect(b.status).to.equal(previous);expect(b.endTime).to.be.a('string');
  });
}

docs {
  check_manual_case=restart。先完成正常流程，保留 Bruno 运行时变量，重启同一工作目录下的服务，再发送本请求。
  不能先重新创建测试域或提交新任务；否则比较的不是重启前同一次任务。日志目录必须仍为同一位置。
}

example {
  name: 重启后仍可查询

  request: {
    url: {{ip}}/api/domain/{{check_domain}}/status?user={{check_user}}&pwd={{check_pwd}}
    method: GET
    mode: none
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "domain": "bruno-build-check-demo",
          "taskId": "bruno-build-check-demo-1793000000",
          "status": "succeeded",
          "enqueuedAt": "2026-10-26T12:00:00+08:00",
          "startTime": "2026-10-26T12:00:01+08:00",
          "endTime": "2026-10-26T12:00:05+08:00",
          "exitCode": 0
        }
      '''
    }
  }
}

