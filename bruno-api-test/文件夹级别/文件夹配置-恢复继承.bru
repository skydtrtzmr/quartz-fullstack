meta {
  name: 文件夹配置-恢复继承
  type: http
  seq: 4
}

delete {
  url: {{ip}}/api/domain/{{domain}}/_folder/{{folder}}?user=admin&pwd=password123
  body: none
  auth: inherit
}

params:query {
  user: admin
  pwd: password123
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  删掉某目录的 aggregation、properties、sort 三项覆盖（= 恢复逐层继承）。
  
  等价于 PUT 同 URL + {"aggregation": {"fields": []}, "properties": {"fields": []}, "sort": null}。
  响应里的 inherit_from / inherit_fields 与 sort.effective / sort.from 会显示继承结果。
  
  「整个域不做字段聚合」不是删某个目录，而是改链段的 default：
  PUT /api/domain/{domain} + {"aggregation": {"default": []}}
}
