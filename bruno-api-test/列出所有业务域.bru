meta {
  name: 列出所有业务域
  type: http
  seq: 2
}

get {
  url: {{ip}}/api/domains?user=admin&pwd=password123
  body: none
  auth: inherit
}

params:query {
  user: admin
  pwd: password123
}

docs {
  列出所有业务域（v5）。

  响应：count + domains[]，每个元素是 DomainMeta：

  | 字段 | 说明 |
  |------|------|
  | domain_name | 域名（settings 下的目录名） |
  | display_name | 显示名，取自 configuration.pageTitle，缺失时回落为域名 |
  | page_title | configuration.pageTitle 原值 |
  | base_url | configuration.baseUrl |
  | plugin_count / enabled_plugins | plugins 段条目数 / enabled 条目的 source 列表 |
  | aggregation | configuration.aggregation 视图：folder_depth / default / folders |
  | warnings | 结构校验告警（缺 pageTitle/baseUrl、plugins 缺 source 等） |

  读不出来的域会被跳过并在服务端日志里记一行，不影响其它域。
}

settings {
  encodeUrl: true
  timeout: 0
}
