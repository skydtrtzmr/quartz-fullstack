meta {
  name: 触发指定业务域构建
  type: http
  seq: 4
}

post {
  url: http://192.168.254.221:8766/api/domain/test1/build?user=admin&pwd=password123&reset=true
  body: none
  auth: inherit
}

params:query {
  user: admin
  pwd: password123
  reset: true
}

vars:pre-request {
  domain: xm
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example1
  
  request: {
    url: http://192.168.254.221:8766/api/domain/test0/build?user=admin&pwd=password123&reset=true
    method: POST
    mode: none
    params:query: {
      user: admin
      pwd: password123
      reset: true
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Accept-Encoding
      date: Fri, 24 Jul 2026 08:18:56 GMT
      content-length: 197
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "Accepted",
          "message": "Build triggered for domain: test0 (--reset)",
          "command": "node --no-deprecation ./quartz/bootstrap-cli.mjs build --sqlite --reset --settings C:/Project/quartz-fullstack/settings/test0 -d C:/Project/quartz-fullstack/input/test0 -o C:/Project/quartz-fullstack/output/test0"
        }
      '''
    }
  }
}
