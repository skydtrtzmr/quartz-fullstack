meta {
  name: 修改业务域配置
  type: http
  seq: 8
}

put {
  url: {{ip}}/api/domain/test1?user=admin&pwd=password123
  body: json
  auth: inherit
}

params:query {
  user: admin
  pwd: password123
}

body:json {
  {
    "layout": {
      {
        "explorer": {
          "sort": {
            "type": "natural",
            "order": "asc",
            "field": ""
          }
        },
        "folderPage": {
          "sort": {
            "type": "natural",
            "order": "asc",
            "field": ""
          }
        },
        "backlinks": {
          "hideWhenEmpty": false,
          "aggregation": [
            {
              "type": "folder",
              "depth": 1
            },
            {
              "type": "field",
              "field": "type"
            },
            {
              "type": "date",
              "field": "date",
              "granularity": "year"
            }
          ]
        },
        "graph": {
          "coreNodeFilter": [
            {
              "type": "folder",
              "depth": 1,
              "values": [
                "项目"
              ]
            }
          ],
          "coreNodeLimit": 50,
          "regionRules": [
            {
              "type": "field",
              "field": "type"
            }
          ],
          "aggregation": [
            {
              "type": "folder",
              "depth": 2,
              "granularity": ""
            },
            {
              "type": "field",
              "field": "type",
              "depth": 0
            },
            {
              "type": "date",
              "field": "date",
              "granularity": "year"
            }
          ]
        }
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example1
  
  request: {
    url: 127.0.0.1:8766/api/domain/xm2?user=admin&pwd=password123
    method: PUT
    mode: json
    params:query: {
      user: admin
      pwd: password123
    }
  
    body:json: {
      {
        "config": {
          "pageTitle": "我的项目知识库",
          "graph": {
            "tags": {
              "color": "#4a9eff",
              "displayName": "标签"
            },
            "category": {
              "color": "#ff6b6b",
              "displayName": "分类"
            }
          }
        },
        "layout": {
          "backlinks": {
            "hideWhenEmpty": false,
            "aggregation": {
              "folder": {
                "depth": 2,
                "flatten": true
              },
              "fields": [
                { "field": "date", "granularity": "year", "order": 1 },
                { "field": "tags", "granularity": "none", "order": 2 }
              ]
            }
          }
        }
      }
                        
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
